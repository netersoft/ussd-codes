{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "dart-mcp-server": {
      "type": "local",
      "command": ["dart", "mcp-server"],
      "enabled": true
    },
    "marionette": {
      "type": "local",
      "command": ["dart", "run", "marionette_mcp"],
      "enabled": false
    }
  }
}
